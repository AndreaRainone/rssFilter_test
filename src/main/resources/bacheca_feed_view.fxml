<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>

<VBox spacing="20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.faris.BachecaFeedController">

    <!-- Barra di Ricerca (RF_GBN_03) -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <HBox styleClass="search-box" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" style="-fx-padding: 0 15 0 15;">
            <Label text="🔍" style="-fx-text-fill: #888888; -fx-padding: 0 8 0 0;"/>
            <TextField fx:id="searchField" promptText="Cerca news, argomenti o keyword nel feed..." style="-fx-background-color: transparent; -fx-pref-height: 42px;" HBox.hgrow="ALWAYS"/>
        </HBox>
    </HBox>

    <!-- Filtri Rapidi Categorie -->
    <HBox spacing="10">
        <ToggleButton text="Tutte" styleClass="interest-chip-compact" selected="true"/>
        <ToggleButton text="Tecnologia" styleClass="interest-chip-compact"/>
        <ToggleButton text="Global News" styleClass="interest-chip-compact"/>
        <ToggleButton text="Anime &amp; Manga" styleClass="interest-chip-compact"/>
        <ToggleButton text="Open Source" styleClass="interest-chip-compact"/>
    </HBox>

    <!-- Elenco Notizie Scrollabile -->
    <ScrollPane fitToWidth="true" styleClass="custom-scroll-pane" VBox.vgrow="ALWAYS">
        <VBox spacing="20" style="-fx-padding: 8 12 20 2;">

            <!-- DIV NOTIZIA 1: Con Immagine RSS -->
            <HBox styleClass="content-card" spacing="18" alignment="CENTER_LEFT">
                <StackPane styleClass="card-image-container" minWidth="160" prefWidth="160" minHeight="105" prefHeight="105">
                    <ImageView fx:id="imgNews1" fitWidth="160" fitHeight="105" preserveRatio="false" styleClass="card-image"/>
                </StackPane>

                <VBox HBox.hgrow="ALWAYS" spacing="10">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Technology" styleClass="badge-category-tech"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="2 ore fa • TechCrunch" styleClass="card-meta"/>
                    </HBox>

                    <VBox spacing="4">
                        <Label text="Rilasciata la nuova architettura esagonale per framework Java" styleClass="card-title" wrapText="true"/>
                        <Label text="Il nuovo aggiornamento introduce miglioramenti significativi nella gestione dei domini isolati e dei driven adapter per basi di dati relazionali." styleClass="card-description" wrapText="true"/>
                    </VBox>

                    <!-- Footer Pulsanti in Basso a Destra -->
                    <HBox alignment="BOTTOM_RIGHT" spacing="10">
                        <Button text="✏️ Aggiungi Nota" styleClass="btn-outline-small" onAction="#handleAddNote"/>
                        <Button text="Leggi Articolo" styleClass="btn-primary-small" onAction="#handleReadArticle"/>
                    </HBox>
                </VBox>
            </HBox>

            <!-- DIV NOTIZIA 2: Con Immagine RSS + Badge Nota Esperto -->
            <HBox styleClass="content-card" spacing="18" alignment="CENTER_LEFT">
                <StackPane styleClass="card-image-container" minWidth="160" prefWidth="160" minHeight="105" prefHeight="105">
                    <ImageView fx:id="imgNews2" fitWidth="160" fitHeight="105" preserveRatio="false" styleClass="card-image"/>
                </StackPane>

                <VBox HBox.hgrow="ALWAYS" spacing="10">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Global News" styleClass="badge-category-global"/>
                        <Label text="📝 Contiene Nota Esperto" styleClass="badge-expert-note"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="4 ore fa • Reuters" styleClass="card-meta"/>
                    </HBox>

                    <VBox spacing="4">
                        <Label text="Le Nazioni Unite chiedono un'azione globale più forte sul cambiamento climatico" styleClass="card-title" wrapText="true"/>
                        <Label text="Nuovi accordi internazionali fissano obiettivi rigorosi per la riduzione delle emissioni entro il 2030." styleClass="card-description" wrapText="true"/>
                    </VBox>

                    <!-- Footer Pulsanti in Basso a Destra -->
                    <HBox alignment="BOTTOM_RIGHT" spacing="10">
                        <Button text="✏️ Modifica Nota" styleClass="btn-outline-small" onAction="#handleAddNote"/>
                        <Button text="Leggi Articolo" styleClass="btn-primary-small" onAction="#handleReadArticle"/>
                    </HBox>
                </VBox>
            </HBox>

        </VBox>
    </ScrollPane>
</VBox>