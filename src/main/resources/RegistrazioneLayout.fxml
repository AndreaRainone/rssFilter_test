<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<!-- ROOT: Sfondo totalmente trasparente. Assicurati di cambiare "tuo.package.RegistrazioneController" con il nome reale del tuo controller -->
<AnchorPane prefHeight="540.0" prefWidth="840.0" styleClass="root-trasparente" stylesheets="@style.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="TODO">
    <children>
        <!-- LA FINESTRA VISIBILE: Sfondo scuro, bordi curvi e ombra -->
        <HBox layoutX="20.0" layoutY="20.0" prefHeight="500.0" prefWidth="800.0" spacing="20.0" styleClass="sfondo-principale">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>

                <!-- PARTE SINISTRA: Il blocco viola -->
                <VBox prefHeight="470.0" prefWidth="350.0" styleClass="pannello-sinistro" />

                <!-- PARTE DESTRA: L'area dinamica del Form -->
                <BorderPane prefHeight="470.0" prefWidth="420.0">

                    <!-- TOP: Bottone per chiudere l'app -->
                    <top>
                        <HBox alignment="TOP_RIGHT" BorderPane.alignment="CENTER">
                            <children>
                                <Button fx:id="btnChiudi" mnemonicParsing="false" onAction="#chiudiFinestra" styleClass="bottone-chiudi" text="X" />
                            </children>
                        </HBox>
                    </top>

                    <!-- CENTER: IL "BUCO" DOVE INIETTEREMO GLI STEP 1, 2, 3 e 4 -->
                    <center>
                        <StackPane fx:id="pannelloCentrale" prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
                    </center>

                    <!-- BOTTOM: Bottoni Avanti/Indietro e Pillole -->
                    <bottom>
                        <HBox alignment="CENTER_LEFT" spacing="15.0" BorderPane.alignment="CENTER">
                            <children>
                                <!-- Bottone Indietro (Nascosto di default al primo step) -->
                                <Button fx:id="btnIndietro" mnemonicParsing="false" onAction="#vaiIndietro" prefHeight="40.0" prefWidth="100.0" styleClass="campo-testo" text="INDIETRO" visible="false" />

                                <!-- Spaziatore elastico -->
                                <Region HBox.hgrow="ALWAYS" />

                                <!-- Pillole colorate -->
                                <HBox alignment="CENTER" spacing="10.0">
                                    <children>
                                        <Circle fx:id="pillola1" fill="#7255bd" radius="5.0" stroke="TRANSPARENT" strokeType="INSIDE" />
                                        <Circle fx:id="pillola2" fill="#413a58" radius="5.0" stroke="TRANSPARENT" strokeType="INSIDE" />
                                        <Circle fx:id="pillola3" fill="#413a58" radius="5.0" stroke="TRANSPARENT" strokeType="INSIDE" />
                                        <Circle fx:id="pillola4" fill="#413a58" radius="5.0" stroke="TRANSPARENT" strokeType="INSIDE" />
                                    </children>
                                </HBox>

                                <!-- Spaziatore elastico -->
                                <Region HBox.hgrow="ALWAYS" />

                                <!-- Bottone Avanti -->
                                <Button fx:id="btnAvanti" mnemonicParsing="false" onAction="#vaiAvanti" prefHeight="40.0" prefWidth="100.0" styleClass="bottone-viola" text="AVANTI" />
                            </children>
                            <padding>
                                <Insets bottom="10.0" top="20.0" />
                            </padding>
                        </HBox>
                    </bottom>

                </BorderPane>
            </children>
        </HBox>
    </children>
</AnchorPane>