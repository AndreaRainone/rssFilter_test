<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="it.faris.Step3Controller">

    <!-- Box di avviso Rosa -->
    <HBox alignment="CENTER_LEFT" spacing="15" styleClass="alert-box">
        <!-- Finta icona per simulare il badge -->
        <Label style="-fx-background-color: #991845; -fx-text-fill: white; -fx-background-radius: 50; -fx-min-width: 35; -fx-min-height: 35; -fx-alignment: center; -fx-font-weight: bold;" text="✓" />
        <VBox spacing="2">
            <Label style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #111827;" text="Sei un esperto?" />
            <Label style="-fx-text-fill: #4B5563; -fx-font-size: 13px; -fx-wrap-text: true;" text="Lascia il tuo contributo sulla piattaforma. Inserisci il token che attesti la tua professione." />
        </VBox>
    </HBox>

    <TextField fx:id="tokenField" promptText="TOKEN" style="-fx-pref-height: 55px; -fx-font-size: 18px; -fx-alignment: center;" styleClass="input-field">
      <font>
         <Font name="Berlin Sans FB Demi Bold" size="12.0" />
      </font></TextField>

    <Region minHeight="20" VBox.vgrow="ALWAYS" />

    <HBox alignment="CENTER_RIGHT" spacing="15">
        <Button onAction="#goBack" styleClass="btn-outline" text="Indietro">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="12.0" />
         </font></Button>
        <Region HBox.hgrow="ALWAYS" />
        <Label onMouseClicked="#goNext" style="-fx-text-fill: #888; -fx-font-weight: bold; -fx-cursor: hand;" text="Ignora">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="12.0" />
         </font></Label>
        <Button onAction="#goNext" prefWidth="120" styleClass="btn-primary" text="Verifica">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="12.0" />
         </font></Button>
    </HBox>
</VBox>
