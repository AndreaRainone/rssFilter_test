<AnchorPane prefHeight="230.0" prefWidth="380.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CONTROLLER_NAME">
   <children>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="12.0" style="-fx-background-color: #23202E; -fx-background-radius: 18; -fx-border-color: #433D54; -fx-border-radius: 18; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 16, 0, 0, 6);" AnchorPane.bottomAnchor="12.0" AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0">
         <padding>
            <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
         </padding>
         <children>
            <StackPane prefWidth="200.0">
               <children>
                  <Circle fill="#ff5252" radius="20.0" stroke="BLACK" strokeType="INSIDE" />
                  <Label text="!" textFill="WHITE">
                     <font>
                        <Font name="Berlin Sans FB Demi Bold" size="22.0" />
                     </font>
                  </Label>
               </children>
            </StackPane>
            <Label id="titoloLabel" text="Accesso non riuscito" textFill="WHITE">
               <font>
                  <Font name="Berlin Sans FB Demi Bold" size="16.0" />
               </font>
            </Label>
            <Label id="messaggioLabel" alignment="CENTER" text="Username o password non corretti. Per favore riprova." textFill="#9e9aa8" wrapText="true">
