<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="700" prefWidth="600" styleClass="transparent-root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.faris.LoginController">
    <AnchorPane maxHeight="550" maxWidth="450" styleClass="floating-card">

        <Label onMouseClicked="#closeApp" styleClass="close-btn" text="✕" AnchorPane.rightAnchor="25" AnchorPane.topAnchor="20" />

        <VBox alignment="CENTER_LEFT" spacing="25" AnchorPane.leftAnchor="40" AnchorPane.rightAnchor="40" AnchorPane.topAnchor="50">
            <VBox spacing="5">
                <Label styleClass="title-label" text="Bentornato" textAlignment="CENTER">
               <font>
                  <Font name="Berlin Sans FB Demi Bold" size="12.0" />
               </font></Label>
                <Label alignment="CENTER" styleClass="subtitle-label" text="Effettua l'accesso ed inizia a navigare" textAlignment="CENTER">
               <font>
                  <Font name="Berlin Sans FB Demi Bold" size="12.0" />
               </font></Label>
            </VBox>

            <VBox spacing="20">
                <StackPane alignment="CENTER_LEFT">
                    <TextField fx:id="usernameField" styleClass="custom-input" />
                    <Label styleClass="input-icon" text="👤" />
                    <Label fx:id="userLabel" mouseTransparent="true" styleClass="floating-label" text="Username" />
                </StackPane>

                <StackPane alignment="CENTER_LEFT">
                    <PasswordField fx:id="passwordField" styleClass="custom-input" />
                    <Label styleClass="input-icon" text="🔒" />
                    <Label fx:id="passLabel" mouseTransparent="true" styleClass="floating-label" text="Password" />
                </StackPane>
            </VBox>

            <HBox alignment="CENTER_LEFT">
                <CheckBox style="-fx-text-fill: #555;" text="Ricordami">
               <font>
                  <Font name="Berlin Sans FB Demi Bold" size="14.0" />
               </font></CheckBox>
                <Region HBox.hgrow="ALWAYS" />
                <Hyperlink styleClass="link-accent" text="Password Dimenticata?">
               <font>
                  <Font name="Berlin Sans FB Demi Bold" size="14.0" />
               </font></Hyperlink>
            </HBox>

            <Button maxWidth="Infinity" onAction="#handleLogin" styleClass="btn-primary" text="Login" />

            <HBox alignment="CENTER" spacing="5" style="-fx-padding: 10 0 0 0;">
                <Label style="-fx-text-fill: #555;" text="Sei nuovo in zona?" />
                <Hyperlink onAction="#openRegistration" styleClass="link-accent" text="Registrati">
               <font>
                  <Font name="Berlin Sans FB Demi Bold" size="14.0" />
               </font></Hyperlink>
            </HBox>
        </VBox>

    </AnchorPane>
</StackPane>
