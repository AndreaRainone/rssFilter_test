<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane styleClass="transparent-root" stylesheets="@style.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="it.faris.LoginController">
    <VBox maxHeight="-Infinity" maxWidth="400" spacing="20" style="-fx-padding: 30 35 30 35;" styleClass="floating-card">

        <HBox alignment="TOP_RIGHT">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="title-label" text="Bentornato">
               <font>
                  <Font name="Berlin Sans FB Demi Bold" size="14.0" />
               </font></Label>
                <Label styleClass="subtitle-label" text="Effettua l'accesso ed inizia a navigare">
               <font>
                  <Font name="Berlin Sans FB Demi Bold" size="12.0" />
               </font></Label>
            </VBox>
            <Label onMouseClicked="#closeApp" styleClass="close-btn" text="✕" />
        </HBox>

        <VBox spacing="14">
            <!-- Aggiunta la classe login-input-field per il padding interno -->
            <TextField fx:id="usernameField" promptText="Username" styleClass="input-field, login-input-field" />
            <PasswordField fx:id="passwordField" promptText="Password" styleClass="input-field, login-input-field" />
        </VBox>

        <HBox alignment="CENTER_LEFT">
            <CheckBox style="-fx-text-fill: #6B7280;" text="Ricordami">
            <font>
               <Font name="Berlin Sans FB Demi Bold" size="14.0" />
            </font></CheckBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="link-forgot" text="Password Dimenticata?" />
        </HBox>

        <Button maxWidth="Infinity" styleClass="btn-primary" text="Login" />

        <HBox alignment="CENTER" spacing="5" style="-fx-padding: 10 0 0 0;">
            <Label style="-fx-text-fill: #555;" text="Sei nuovo in zona?">
            <font>
               <Font name="Berlin Sans FB Demi Bold" size="14.0" />
            </font></Label>
            <Label onMouseClicked="#openRegistration" styleClass="link-register" text="Registrati" />
        </HBox>

    </VBox>
</StackPane>
